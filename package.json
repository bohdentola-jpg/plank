{
  "name": "eb-games",
  "version": "1.0.0",
  "description": "EB GAMES — a shelf of no-build-step 3D browser games. VARSITY 27 (high school football) and NO VACANCY (hotel tycoon).",
  "type": "module",
  "scripts": {
    "start": "python3 serve.py",
    "shot": "node tools/shot.mjs",
    "smoke": "node tools/smoke.mjs && node tools/hotel-smoke.mjs",
    "smoke:hotel": "node tools/hotel-smoke.mjs",
    "balance": "node tools/hotel-smoke.mjs --days 60",
    "leakcheck": "node tools/hotel-leakcheck.mjs",
    "uicheck": "node tools/hotel-uicheck.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
